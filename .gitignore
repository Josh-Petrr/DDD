# ─────────────────────────────────────────────
# Driver Drowsiness Detection (DDD) — .gitignore
# ─────────────────────────────────────────────

# ── Data directory (dataset, splits, features — reproducible) ──
data/
ml_pipeline/extract_features.py

# ── Trained model checkpoints (binary, large) ──
# Ignore all checkpoints by default
assets/checkpoints/*
# Except the best models
!assets/checkpoints/V4/
!assets/checkpoints/V4/fusion_grl_4_best.pth
!assets/checkpoints/lstm_best.pth

# ── Python cache ──
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/

# ── Python virtual environments ──
venv/
.venv/
env/
.env/
ENV/

# ── Environment variable files ──
.env
.env.local
.env.*.local

# ── Node.js (for when frontend is added) ──
node_modules/
dist/
.next/
build/

# ── Jupyter ──
.ipynb_checkpoints/
*.ipynb

# ── OS files ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user

# ── Results (generated output — reproducible via generate_report.py) ──
# Comment these out if you want to commit result plots to the repo
results/*.png
results/*.csv
results/*.json

# Ignore all subfolders in results...
results/*/
# ...except the latest results
!results/result_V4/
!results/lstm_1/

# ── Logs ──
*.log
logs/

# ── Temporary files ──
*.tmp
*.temp

# ── Specific files requested to ignore ──
Recency.md
Restructuring Project for Fullstack Application.md
docs/drowsiness_feature_fusion_plan.md
docs/task/
