# ─────────────────────────────────────────────
# Driver Drowsiness Detection (DDD) — .gitignore
# ─────────────────────────────────────────────

# ── Data directory (dataset, splits, features — reproducible) ──
data/

# ── ml_pipeline directory ──
ml_pipeline/extract_filenames.py
ml_pipeline/export_unseen_data.py

# ── Trained model checkpoints (binary, large) ──
assets/checkpoints/*
!assets/checkpoints/V4/
!assets/checkpoints/lstm_best.pth

# ── Root level specific files ──
Recency.md
Restructuring Project for Fullstack Application.md

# ── Docs directory ──
docs/*
!docs/generate_report.py
!docs/generate_lstm_report.py
!docs/MDS505.pdf
!docs/task/

# ── Results directory ──
results/*
!results/final_results/
!results/result_V4/

# ── Python cache ──
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/

# ── Python virtual environments ──
venv/
.venv/
env/
.env/
ENV/

# ── Environment variable files ──
.env
.env.local
.env.*.local

# ── Node.js (for when frontend is added) ──
node_modules/
dist/
.next/
build/

# ── Jupyter ──
.ipynb_checkpoints/
*.ipynb

# ── OS files ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user

# ── Logs ──
*.log
logs/

# ── Temporary files ──
*.tmp
*.temp
